    hour12: $("hour12"),
    volume: $("volume"),
    volLabel: $("volLabel"),
    btnNotify: $("btnNotify"),
    btnReset: $("btnReset")
  };

  /* ============================================================
     UTILITIES
     ============================================================ */
  function pad(n) { return String(n).padStart(2, "0"); }

  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

  function fmtTime(ms, tz, hour12) {
    try {
      return new Intl.DateTimeFormat(hour12 ? "en-US" : "en-GB", {
        timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: !!hour12
      }).format(new Date(ms));
    } catch (e) { return "--:--"; }
  }

  function fmtClock(ms, tz, hour12) {
    try {
      return new Intl.DateTimeFormat(hour12 ? "en-US" : "en-GB", {
        timeZone: tz, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: !!hour12
      }).format(new Date(ms));
    } catch (e) { return "--:--:--"; }
  }

  function fmtDate(ms, tz) {
    try {
      return new Intl.DateTimeFormat(undefined, {
        timeZone: tz, weekday: "short", month: "short", day: "numeric"
      }).format(new Date(ms));
    } catch (e) { return ""; }
  }

  function fmtDayTime(ms, tz, hour12) {
    try {
      return new Intl.DateTimeFormat(undefined, {
        timeZone: tz, weekday: "short", hour: "2-digit", minute: "2-digit", hour12: !!hour12
      }).format(new Date(ms));
    } catch (e) { return "--"; }
  }

  function countdownText(ms) {
    if (!isFinite(ms) || ms < 0) ms = 0;
    var total = Math.floor(ms / 1000);
    var d = Math.floor(total / 86400);
    var h = Math.floor((total % 86400) / 3600);
    var m = Math.floor((total % 3600) / 60);
    var s = total % 60;
    return (d > 0 ? d + "d " : "") + pad(h) + ":" + pad(m) + ":" + pad(s);
  }

  function relText(ms) {
    if (ms == null || !isFinite(ms)) return "—";
    var s = Math.max(0, Math.floor(ms / 1000));
    var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
    if (d > 0) return "in " + d + "d " + h + "h";
    if (h > 0) return "in " + h + "h " + m + "m";
    if (m > 0) return "in " + m + "m";
    return "in " + s + "s";
  }

  function durationText(ms) {
    var s = Math.max(0, Math.round(ms / 60000));
    var h = Math.floor(s / 60), m = s % 60;
    if (h && m) return h + "h " + m + "m";
    if (h) return h + "h";
    return m + "m";
  }

  function tzOffsetMs(tz, ms) {
    try {
      var d = new Date(ms);
      var parts = new Intl.DateTimeFormat("en-US", {
        timeZone: tz, hour12: false,
        year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", second: "2-digit"
      }).formatToParts(d);
      var p = {};
      for (var i = 0; i < parts.length; i++) p[parts[i].type] = parts[i].value;
      var hour = parseInt(p.hour, 10);
      if (hour === 24) hour = 0;
      var asUTC = Date.UTC(
        parseInt(p.year, 10), parseInt(p.month, 10) - 1, parseInt(p.day, 10),
        hour, parseInt(p.minute, 10), parseInt(p.second, 10)
      );
      return asUTC - Math.floor(d.getTime() / 1000) * 1000;
    } catch (e) { return 0; }
  }

  function startOfLocalDay(tz, ms) {
    var off = tzOffsetMs(tz, ms);
    var local = new Date(ms + off);
    var midnightUTC = Date.UTC(local.getUTCFullYear(), local.getUTCMonth(), local.getUTCDate());
    var guess = midnightUTC - off;
    var off2 = tzOffsetMs(tz, guess);
    return midnightUTC - off2;
  }

  /* ============================================================
     SCHEDULE ENGINE
     ============================================================ */
  function isPeakAt(date) {
    var wins = state.windows;
    if (!wins || !wins.length) return false;

    if (state.weekendsOffPeak) {
      var dow = date.getUTCDay();
      if (dow === 0 || dow === 6) return false;
    }

    var m = date.getUTCHours() * 60 + date.getUTCMinutes();
    for (var i = 0; i < wins.length; i++) {
      var s = wins[i][0], e = wins[i][1];
      if (s === e) continue;
      if (s < e) {
        if (m >= s && m < e) return true;
      } else {
        if (m >= s || m < e) return true;
      }
    }
    return false;
  }

  function getBoundaries(nowMs) {
    var d = new Date(nowMs);
    var dayStart = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    var set = new Set();
    var wins = state.windows || [];

    for (var i = -2; i <= 9; i++) {
      var ds = dayStart + i * DAY;
      set.add(ds);
      for (var j = 0; j < wins.length; j++) {
        var s = wins[j][0], e = wins[j][1];
        if (s === e) continue;
        set.add(ds + s * MIN);
        set.add(ds + (e > s ? e : e + 1440) * MIN);
      }
    }
    return Array.from(set).sort(function (a, b) { return a - b; });
  }

  function computeTransitions(nowMs) {
    var arr = getBoundaries(nowMs);
    var curPeak = isPeakAt(new Date(nowMs));
    var prev = null, next = null, nextPeak = null, nextOff = null;

    for (var i = 0; i < arr.length; i++) {
      var t = arr[i];
      if (t <= nowMs) { prev = t; continue; }
      var p = isPeakAt(new Date(t));
      if (next === null && p !== curPeak) next = t;
      if (nextPeak === null && p) nextPeak = t;
      if (nextOff === null && !p) nextOff = t;
      if (next !== null && nextPeak !== null && nextOff !== null) break;
    }
    return { prev: prev, next: next, nextPeak: nextPeak, nextOff: nextOff, curPeak: curPeak };
  }

  /* ============================================================
     AUDIO
     ============================================================ */
  function getAudio() {
    if (!state.sound) return null;
    try {
      var Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      if (!AC) AC = new Ctx();
      if (AC.state === "suspended") AC.resume();
      return AC;
    } catch (e) { return null; }
  }

  function tone(ctx, freq, at, dur, type, vol) {
    try {
      var o = ctx.createOscillator();
      var g = ctx.createGain();
      var v = clamp((vol || 0.2) * state.volume * 3, 0.0002, 0.9);
      o.type = type || "sine";
      o.frequency.setValueAtTime(freq, at);
      g.gain.setValueAtTime(0.0001, at);
      g.gain.exponentialRampToValueAtTime(v, at + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
      o.connect(g).connect(ctx.destination);
      o.start(at);
      o.stop(at + dur + 0.05);
    } catch (e) { /* ignore */ }
  }

  function playSiren() {
    var ctx = getAudio();
    if (!ctx) return;
    var t0 = ctx.currentTime + 0.02;
    for (var i = 0; i < 3; i++) {
      var b = t0 + i * 0.42;
      tone(ctx, 980, b, 0.15, "square", 0.16);
      tone(ctx, 660, b + 0.19, 0.17, "square", 0.16);
    }
    tone(ctx, 1320, t0 + 1.32, 0.42, "sawtooth", 0.13);
  }

  function playChime() {
    var ctx = getAudio();
    if (!ctx) return;
    var t0 = ctx.currentTime + 0.02;
    tone(ctx, 523.25, t0, 0.22, "sine", 0.18);
    tone(ctx, 659.25, t0 + 0.14, 0.24, "sine", 0.18);
    tone(ctx, 783.99, t0 + 0.29, 0.42, "sine", 0.18);
  }

  function playLeadWarning() {
    var ctx = getAudio();
    if (!ctx) return;
    var t0 = ctx.currentTime + 0.02;
    tone(ctx, 880, t0, 0.12, "triangle", 0.18);
    tone(ctx, 880, t0 + 0.2, 0.12, "triangle", 0.18);
  }

  function startAlarm() {
    stopAlarm();
    playSiren();
    state.repeatCount = 1;
    if (state.persistent) {
      state.repeatTimer = setInterval(function () {
        if (state.silenced || state.repeatCount >= 8) { stopAlarm(); return; }
        state.repeatCount++;
        playSiren();
      }, 30000);
    }
  }

  function stopAlarm() {
    if (state.repeatTimer) { clearInterval(state.repeatTimer); state.repeatTimer = null; }
  }

  /* ============================================================
     VISUAL FX
     ============================================================ */
  function flashScreen(peak) {
    var f = el.flash;
    f.style.background = peak
      ? "radial-gradient(120% 85% at 50% 0%, rgba(244,63,94,.60), rgba(244,63,94,.10) 55%, transparent 75%)"
      : "radial-gradient(120% 85% at 50% 0%, rgba(16,185,129,.50), rgba(16,185,129,.08) 55%, transparent 75%)";
    f.classList.remove("flashing");
    void f.offsetWidth;
    f.classList.add("flashing");
  }

  function shakeCard() {
    el.card.classList.remove("shake");
    void el.card.offsetWidth;
    el.card.classList.add("shake");
    setTimeout(function () { el.card.classList.remove("shake"); }, 800);
  }

  function showBanner(show) {
    if (show === state.bannerShown) return;
    state.bannerShown = show;
    if (show) {
      el.alarmBar.classList.remove("hidden");
      el.alarmBar.classList.add("flex");
      requestAnimationFrame(function () {
        el.alarmBar.classList.remove("-translate-y-full");
      });
    } else {
      el.alarmBar.classList.add("-translate-y-full");
      setTimeout(function () {
        if (!state.bannerShown) {
          el.alarmBar.classList.add("hidden");
          el.alarmBar.classList.remove("flex");
        }
      }, 340);
    }
  }

  function notify(isPeak) {
    try {
      if (!("Notification" in window) || Notification.permission !== "granted") return;
      new Notification(isPeak ? "🔴 PEAK window started" : "🟢 Off-peak window started", {
        body: isPeak
          ? "Surge pricing is now active. Consider delaying non-urgent jobs."
          : "Prices dropped — off-peak discount is live.",
        tag: "peak-alarm",
        renotify: true
      });
    } catch (e) { /* ignore */ }
  }

  /* ============================================================
     TIME ZONE LIST
     ============================================================ */
  var ALL_ZONES = [];
  var ZONE_LABELS = {};

  function buildZoneList() {
    var zones = [];
    try {
      if (typeof Intl.supportedValuesOf === "function") {
        zones = Intl.supportedValuesOf("timeZone") || [];
      }
    } catch (e) { zones = []; }
    if (!zones.length) zones = FALLBACK_ZONES.slice();
    if (zones.indexOf("UTC") === -1) zones.unshift("UTC");
    if (state.tz && zones.indexOf(state.tz) === -1) zones.unshift(state.tz);
    ALL_ZONES = zones;

    var now = Date.now();
    for (var i = 0; i < zones.length; i++) {
      ZONE_LABELS[zones[i]] = offsetLabel(zones[i], now);
    }
  }

  function offsetLabel(tz, ms) {
    try {
      var parts = new Intl.DateTimeFormat("en-US", {
        timeZone: tz, timeZoneName: "shortOffset", hour: "2-digit"
      }).formatToParts(new Date(ms));
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].type === "timeZoneName") {
          return parts[i].value.replace("GMT", "UTC").replace("UTC+0", "UTC±0");
        }
      }
    } catch (e) { /* ignore */ }
    return "";
  }

  function zoneDisplayName(z) {
    var name = z.replace(/_/g, " ");
    var off = ZONE_LABELS[z];
    return off ? name + "  ·  " + off : name;
  }

  function renderZones(filter) {
    var q = (filter || "").trim().toLowerCase();
    var list = ALL_ZONES.filter(function (z) {
      if (!q) return true;
      return z.toLowerCase().indexOf(q) !== -1 || zoneDisplayName(z).toLowerCase().indexOf(q) !== -1;
    });

    if (!list.length) list = [state.tz];

    el.tzSelect.innerHTML = "";
    var groups = new Map();
    for (var i = 0; i < list.length; i++) {
      var z = list[i];
      var g = z.indexOf("/") !== -1 ? z.split("/")[0] : "Other";
      if (!groups.has(g)) groups.set(g, []);
      groups.get(g).push(z);
    }

    var keys = Array.from(groups.keys()).sort();
    for (var k = 0; k < keys.length; k++) {
      var og = document.createElement("optgroup");
      og.label = keys[k];
      var arr = groups.get(keys[k]);
      for (var j = 0; j < arr.length; j++) {
        var zz = arr[j];
        var opt = document.createElement("option");
        opt.value = zz;
        opt.textContent = zoneDisplayName(zz);
        if (zz === state.tz) opt.selected = true;
        og.appendChild(opt);
      }
      el.tzSelect.appendChild(og);
    }
    el.tzSelect.value = state.tz;
  }

  /* ============================================================
     RENDER: MAIN CARD
     ============================================================ */
  var BASE_CARD = "relative mb-5 overflow-hidden rounded-3xl border p-6 text-center transition-all duration-500 sm:p-10 breathe";

  function renderCard(peak, weekend, T, nowMs) {
    var red = peak;

    el.card.className = BASE_CARD + " " + (red ? "glow-red border-rose-500/40 bg-rose-950/20" : "glow-green border-emerald-500/40 bg-emerald-950/20");
    el.cardGlow.style.background = red
      ? "radial-gradient(80% 110% at 50% 0%, rgba(244,63,94,.30), transparent 68%)"
      : "radial-gradient(80% 110% at 50% 0%, rgba(16,185,129,.26), transparent 68%)";

    var accent = red ? "#fb7185" : "#34d399";
    var accentDim = red ? "rgba(244,63,94,.14)" : "rgba(16,185,129,.14)";
    var accentBorder = red ? "rgba(244,63,94,.45)" : "rgba(16,185,129,.45)";

    if (peak) {
      el.badge.textContent = "● Surge window active";
      el.badge.style.color = accent;
      el.badge.style.background = accentDim;
      el.badge.style.borderColor = accentBorder;
      el.bigText.textContent = "PEAK";
      el.bigText.style.color = accent;
      el.bigText.style.textShadow = "0 0 60px rgba(244,63,94,.65)";
      el.subText.textContent = "Surge pricing is in effect. Token costs are at the standard (higher) rate — delay non-urgent work if you can.";
      el.cdLabel.textContent = "Off-peak returns in";
    } else {
      el.badge.textContent = weekend ? "● Weekend rule active" : "● Standard window";
      el.badge.style.color = accent;
      el.badge.style.background = accentDim;
      el.badge.style.borderColor = accentBorder;
      el.bigText.textContent = "NOT PEAK";
      el.bigText.style.color = accent;
      el.bigText.style.textShadow = "0 0 60px rgba(16,185,129,.55)";
      el.subText.textContent = weekend
        ? "Weekends are always off-peak. Enjoy the discount for the entire weekend."
        : "Off-peak discount is live — pricing is at the reduced rate. Good time to run big jobs.";
      el.cdLabel.textContent = "Next peak starts in";
    }

    /* countdown */
    var nextT = T.next;
    if (nextT != null) {
      var remain = nextT - nowMs;
      el.cdTimer.textContent = countdownText(remain);
      el.cdAt.textContent = fmtDayTime(nextT, state.tz, state.hour12);
      el.cdTimer.style.color = red ? "#fda4af" : "#6ee7b7";

      var span = nextT - (T.prev != null ? T.prev : nextT - 3600000);
      var pct = span > 0 ? clamp(((nowMs - (T.prev != null ? T.prev : nowMs)) / span) * 100, 0, 100) : 0;
      el.progress.style.width = pct.toFixed(2) + "%";
      el.progress.style.background = red
        ? "linear-gradient(90deg,#fb7185,#e11d48)"
        : "linear-gradient(90deg,#34d399,#059669)";
      el.progLeft.textContent = T.prev != null ? fmtTime(T.prev, state.tz, state.hour12) : "—";
      el.progRight.textContent = fmtTime(nextT, state.tz, state.hour12);
    } else {
      el.cdTimer.textContent = "--:--:--";
      el.cdAt.textContent = "no transitions configured";
      el.progress.style.width = "0%";
      el.progLeft.textContent = "—";
      el.progRight.textContent = "—";
    }
  }

  /* ============================================================
     RENDER: TIMELINE
     ============================================================ */
  function renderTimeline(nowMs) {
    var tz = state.tz;
    var start = startOfLocalDay(tz, nowMs);

    el.tlZone.textContent = tz.replace(/_/g, " ");

    var frag = document.createDocumentFragment();
    for (var i = 0; i < 48; i++) {
      var t = start + i * HALF;
      var pk = isPeakAt(new Date(t));
      var d = document.createElement("div");
      d.className = "h-full flex-1";
      d.style.background = pk
        ? "linear-gradient(180deg,#fb7185,#9f1239)"
        : "linear-gradient(180deg,#34d399,#065f46)";
      d.style.opacity = pk ? "0.92" : "0.72";
      d.title = fmtTime(t, tz, state.hour12) + " — " + (pk ? "PEAK" : "OFF-PEAK");
      frag.appendChild(d);
    }
    el.timeline.innerHTML = "";
    el.timeline.appendChild(frag);

    var pos = ((nowMs - start) / DAY) * 100;
    if (pos >= 0 && pos <= 100) {
      el.nowMarker.style.display = "block";
      el.nowMarker.style.left = pos + "%";
    } else {
      el.nowMarker.style.display = "none";
    }

    var ticksHtml = "";
    for (var k = 0; k <= 8; k++) {
      ticksHtml += "<span>" + fmtTime(start + k * 3 * 3600000, tz, state.hour12) + "</span>";
    }
    el.ticks.innerHTML = ticksHtml;
  }

  /* ============================================================
     RENDER: WINDOW LISTS
     ============================================================ */
  function runsFor(start, wantPeak) {
    var runs = [];
    var cur = null;
    for (var i = 0; i < 48; i++) {
      var t = start + i * HALF;
      var pk = isPeakAt(new Date(t));
      if (pk === wantPeak) {
        if (!cur) cur = { start: t, end: t + HALF };
        else cur.end = t + HALF;
      } else if (cur) {
        runs.push(cur);
        cur = null;
      }
    }
    if (cur) runs.push(cur);
    return runs;
  }

  function renderList(node, runs, isPeak) {
    if (!runs.length) {
      node.innerHTML = '<li class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 text-xs text-slate-500">No ' +
        (isPeak ? "peak" : "off-peak") + " windows today.</li>';
      return;
    }
    var html = "";
    for (var i = 0; i < runs.length; i++) {
      var r = runs[i];
      var color = isPeak ? "text-rose-300" : "text-emerald-300";
      var dot = isPeak ? "bg-rose-500" : "bg-emerald-500";
      html += '<li class="flex items-center justify-between gap-3 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2">' +
        '<span class="flex items-center gap-2 font-mono text-[13px] ' + color + '">' +
        '<span class="h-2 w-2 shrink-0 rounded-full ' + dot + '"></span>' +
        fmtTime(r.start, state.tz, state.hour12) + " – " + fmtTime(r.end, state.tz, state.hour12) +
        "</span>" +
        '<span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">' +
        durationText(r.end - r.start) + "</span></li>";
    }
    node.innerHTML = html;
  }

  /* ============================================================
     MAIN RENDER LOOP
     ============================================================ */
  function render() {
    var nowMs = Date.now();
    var nowDate = new Date(nowMs);
    var peak = isPeakAt(nowDate);
    var T = computeTransitions(nowMs);
    var weekend = state.weekendsOffPeak && (nowDate.getUTCDay() === 0 || nowDate.getUTCDay() === 6);

    /* ---- state change ---- */
    if (state.lastPeak !== null && state.lastPeak !== peak) {
      state.silenced = false;
      state.leadKey = null;
      if (state.sound) {
        if (peak) { startAlarm(); } else { stopAlarm(); playChime(); }
      }
      flashScreen(peak);
      if (peak) shakeCard();
      notify(peak);
    }
    state.lastPeak = peak;

    /* ---- lead-time warning ---- */
    if (state.sound && state.lead > 0 && T.next != null) {
      var key = T.next + "|" + state.lead;
      if (state.leadKey !== key) {
        var remainMs = T.next - nowMs;
        var leadMs = state.lead * 60000;
        if (remainMs <= leadMs && remainMs > leadMs - 65000) {
          state.leadKey = key;
          playLeadWarning();
        }
      }
    }

    /* ---- banner ---- */
    showBanner(peak && !state.silenced);

    /* ---- card ---- */
    renderCard(peak, weekend, T, nowMs);

    /* ---- stats ---- */
    el.statLocal.textContent = fmtClock(nowMs, state.tz, state.hour12);
    el.statLocalDate.textContent = fmtDate(nowMs, state.tz);
    el.statUTC.textContent = fmtClock(nowMs, "UTC", state.hour12);

    if (T.nextPeak != null) {
      el.statNextPeak.textContent = fmtTime(T.nextPeak, state.tz, state.hour12);
      el.statNextPeakRel.textContent = relText(T.nextPeak - nowMs);
    } else {
      el.statNextPeak.textContent = "—";
      el.statNextPeakRel.textContent = "none scheduled";
    }

    if (T.nextOff != null) {
      el.statNextOff.textContent = fmtTime(T.nextOff, state.tz, state.hour12);
      el.statNextOffRel.textContent = relText(T.nextOff - nowMs);
    } else {
      el.statNextOff.textContent = "—";
      el.statNextOffRel.textContent = "none scheduled";
    }

    /* ---- timeline + lists ---- */
    renderTimeline(nowMs);
    var dayStart = startOfLocalDay(state.tz, nowMs);
    renderList(el.peakList, runsFor(dayStart, true), true);
    renderList(el.offList, runsFor(dayStart, false), false);

    /* ---- title ---- */
    var title = (peak ? "🔴 PEAK" : "🟢 OFF-PEAK") + " · Peak Alarm";
    if (document.title !== title) document.title = title;
  }

  /* ============================================================
     CONFIG APPLY / PERSIST
     ============================================================ */
  function applyPreset() {
    if (state.preset === "custom") {
      state.windows = state.customWindows.map(function (w) { return w.slice(); });
    } else {
      var p = PRESETS[state.preset] || PRESETS.split;
      state.windows = p.windows.map(function (w) { return w.slice(); });
      state.weekendsOffPeak = p.weekendsOffPeak;
    }
    state.lastPeak = null;
    state.leadKey = null;
  }

  function save() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({
        tz: state.tz,
        preset: state.preset,
        customWindows: state.customWindows,
        weekendsOffPeak: state.weekendsOffPeak,
        sound: state.sound,
        persistent: state.persistent,
        lead: state.lead,
        hour12: state.hour12,
        volume: state.volume
      }));
    } catch (e) { /* ignore */ }
  }

  function load() {
    try {
      var raw = localStorage.getItem(LS_KEY);
      if (!raw) return false;
      var o = JSON.parse(raw);
      if (o && typeof o === "object") {
        if (typeof o.tz === "string" && o.tz) state.tz = o.tz;
        if (typeof o.preset === "string" && PRESETS[o.preset]) state.preset = o.preset;
        if (Array.isArray(o.customWindows) && o.customWindows.length) state.customWindows = o.customWindows;
        if (typeof o.weekendsOffPeak === "boolean") state.weekendsOffPeak = o.weekendsOffPeak;
        if (typeof o.sound === "boolean") state.sound = o.sound;
        if (typeof o.persistent === "boolean") state.persistent = o.persistent;
        if (typeof o.lead === "number") state.lead = o.lead;
        if (typeof o.hour12 === "boolean") state.hour12 = o.hour12;
        if (typeof o.volume === "number") state.volume = o.volume;
      }
      return true;
    } catch (e) { return false; }
  }

  function parseWindows(str) {
    var out = [];
    var parts = String(str).split(/[,;\n]+/);
    var re = /^\s*(\d{1,2}):(\d{2})\s*(?:-|–|—|to)\s*(\d{1,2}):(\d{2})\s*$/i;
    for (var i = 0; i < parts.length; i++) {
      var chunk = parts[i].trim();
      if (!chunk) continue;
      var m = chunk.match(re);
      if (!m) return null;
      var sh = parseInt(m[1], 10), sm = parseInt(m[2], 10);
      var eh = parseInt(m[3], 10), em = parseInt(m[4], 10);
      if (sh > 23 || eh > 23 || sm > 59 || em > 59) return null;
      var s = sh * 60 + sm, e = eh * 60 + em;
      if (s === e) continue;
      out.push([s, e]);
    }
    return out.length ? out : null;
  }

  function windowsToText(wins) {
    return wins.map(function (w) {
      return pad(Math.floor(w[0] / 60)) + ":" + pad(w[0] % 60) + "-" +
             pad(Math.floor(w[1] / 60)) + ":" + pad(w[1] % 60);
    }).join(", ");
  }

  /* ============================================================
     UI SYNC
     ============================================================ */
  function syncSoundButton() {
    el.btnSound.innerHTML =
      '<i data-lucide="' + (state.sound ? "bell-ring" : "bell-off") + '" class="h-4 w-4"></i>' +
      "<span>" + (state.sound ? "Alarm On" : "Alarm Off") + "</span>";
    if (state.sound) {
      el.btnSound.style.borderColor = "rgba(34,211,238,.5)";
      el.btnSound.style.background = "rgba(34,211,238,.12)";
      el.btnSound.style.color = "#67e8f9";
    } else {
      el.btnSound.style.borderColor = "";
      el.btnSound.style.background = "";
      el.btnSound.style.color = "";
    }
    if (window.lucide) lucide.createIcons();
  }

  function syncSettings() {
    el.preset.value = state.preset;
    el.lead.value = String(state.lead);
    el.customWindows.value = windowsToText(state.customWindows);
    el.weekend.checked = !!state.weekendsOffPeak;
    el.weekend.disabled = state.preset !== "custom";
    el.weekend.parentElement.style.opacity = state.preset !== "custom" ? "0.55" : "1";
    el.persistent.checked = !!state.persistent;
    el.hour12.checked = !!state.hour12;
    el.volume.value = String(Math.round(state.volume * 100));
    el.volLabel.textContent = Math.round(state.volume * 100) + "%";
    el.customWrap.classList.toggle("hidden", state.preset !== "custom");
  }

  /* ============================================================
     EVENTS
     ============================================================ */
  function bindEvents() {
    /* --- timezone --- */
    el.tzSelect.addEventListener("change", function () {
      state.tz = el.tzSelect.value;
      state.lastPeak = null;
      state.leadKey = null;
      save();
      render();
    });

    var searchTimer = null;
    el.tzSearch.addEventListener("input", function () {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function () {
        renderZones(el.tzSearch.value);
      }, 120);
    });

    el.btnDetect.addEventListener("click", function () {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz) {
          if (ALL_ZONES.indexOf(tz) === -1) {
            ALL_ZONES.unshift(tz);
            ZONE_LABELS[tz] = offsetLabel(tz, Date.now());
          }
          state.tz = tz;
          el.tzSearch.value = "";
          renderZones("");
          state.lastPeak = null;
          save();
          render();
        }
      } catch (e) { /* ignore */ }
    });

    /* --- sound --- */
    el.btnSound.addEventListener("click", function () {
      state.sound = !state.sound;
      if (state.sound) {
        getAudio();
        if (state.lastPeak) startAlarm();
      } else {
        stopAlarm();
      }
      save();
      syncSoundButton();
    });

    el.btnTest.addEventListener("click", function () {
      var wasOff = !state.sound;
      if (wasOff) { state.sound = true; getAudio(); }
      playSiren();
      setTimeout(playChime, 1500);
      if (wasOff) {
        setTimeout(function () {
          state.sound = false;
          syncSoundButton();
          save();
        }, 2400);
      }
    });

    el.btnSilence.addEventListener("click", function () {
      state.silenced = true;
      stopAlarm();
      showBanner(false);
    });

    /* --- settings panel --- */
    el.btnSettings.addEventListener("click", function () {
      el.settings.classList.toggle("hidden");
    });

    el.preset.addEventListener("change", function () {
      state.preset = el.preset.value;
      applyPreset();
      syncSettings();
      save();
      render();
    });

    el.lead.addEventListener("change", function () {
      state.lead = parseInt(el.lead.value, 10) || 0;
      state.leadKey = null;
      save();
    });

    el.customWindows.addEventListener("input", function () {
      var parsed = parseWindows(el.customWindows.value);
      if (!parsed) {
        el.customMsg.textContent = "⚠ Invalid format. Use HH:MM-HH:MM ranges separated by commas.";
        el.customMsg.style.color = "#fb7185";
        return;
      }
      el.customMsg.textContent = "Valid — " + parsed.length + " peak window(s) saved.";
      el.customMsg.style.color = "#34d399";
      state.customWindows = parsed;
      if (state.preset === "custom") {
        applyPreset();
        render();
      }
      save();
    });

    el.weekend.addEventListener("change", function () {
      state.weekendsOffPeak = el.weekend.checked;
      state.lastPeak = null;
      state.leadKey = null;
      save();
      render();
    });

    el.persistent.addEventListener("change", function () {
      state.persistent = el.persistent.checked;
      if (!state.persistent) stopAlarm();
      save();
    });

    el.hour12.addEventListener("change", function () {
      state.hour12 = el.hour12.checked;
      save();
      render();
    });

    el.volume.addEventListener("input", function () {
      state.volume = clamp(parseInt(el.volume.value, 10) / 100, 0, 1);
      el.volLabel.textContent = Math.round(state.volume * 100) + "%";
      save();
    });

    el.btnNotify.addEventListener("click", function () {
      if (!("Notification" in window)) return;
      if (Notification.permission === "granted") {
        el.btnNotify.innerHTML = '<i data-lucide="check" class="h-4 w-4"></i> Notifications enabled';
        if (window.lucide) lucide.createIcons();
        return;
      }
      Notification.requestPermission().then(function (perm) {
        el.btnNotify.innerHTML = perm === "granted"
          ? '<i data-lucide="check" class="h-4 w-4"></i> Notifications enabled'
          : '<i data-lucide="bell-off" class="h-4 w-4"></i> Notifications blocked';
        if (window.lucide) lucide.createIcons();
      }).catch(function () { /* ignore */ });
    });

    el.btnReset.addEventListener("click", function () {
      try { localStorage.removeItem(LS_KEY); } catch (e) { /* ignore */ }
      location.reload();
    });

    /* --- audio unlock on first gesture --- */
    var unlock = function () { if (state.sound && !AC) getAudio(); };
    window.addEventListener("click", unlock, { passive: true });
    window.addEventListener("keydown", unlock);
    window.addEventListener("touchstart", unlock, { passive: true });

    /* --- re-render when tab becomes visible again --- */
    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) { state.lastPeak = isPeakAt(new Date()); render(); }
    });
  }

  /* ============================================================
     BOOT
     ============================================================ */
  function boot() {
    var loaded = load();

    if (!state.tz) {
      try { state.tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC"; }
      catch (e) { state.tz = "UTC"; }
    }

    buildZoneList();
    applyPreset();
    renderZones("");
    syncSettings();
    syncSoundButton();

    /* preset dropdown options */
    Object.keys(PRESETS).forEach(function (key) {
      var o = document.createElement("option");
      o.value = key;
      o.textContent = PRESETS[key].label;
      el.preset.appendChild(o);
    });
    el.preset.value = state.preset;
    syncSettings();

    if (window.lucide) lucide.createIcons();

    bindEvents();

    /* first paint */
    state.lastPeak = isPeakAt(new Date());
    render();
    setInterval(render, 250);

    /* persist auto-detected zone on first visit */
    if (!loaded) save();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
</body>
</html>
