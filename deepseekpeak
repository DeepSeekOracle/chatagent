<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PEAK Alarm · Off-Peak Surge Tracker</title>
<meta name="description" content="Live PEAK / NOT PEAK alarm with countdown, visuals, and every time zone on Earth." />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚨</text></svg>" />
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<style>
  :root { color-scheme: dark; }
  html, body { -webkit-tap-highlight-color: transparent; }
  body {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background-image:
      radial-gradient(900px 500px at 15% -10%, rgba(34,211,238,.10), transparent 60%),
      radial-gradient(900px 500px at 85% -10%, rgba(244,63,94,.10), transparent 60%);
    background-attachment: fixed;
  }
  .glow-red   { box-shadow: 0 0 0 1px rgba(244,63,94,.35), 0 0 70px -12px rgba(244,63,94,.75), inset 0 0 90px -50px rgba(244,63,94,.95); }
  .glow-green { box-shadow: 0 0 0 1px rgba(16,185,129,.32), 0 0 70px -12px rgba(16,185,129,.55), inset 0 0 90px -50px rgba(16,185,129,.9); }
  @keyframes breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.012); } }
  .breathe { animation: breathe 3.8s ease-in-out infinite; }
  @keyframes flashbg { 0% { opacity: 0; } 10% { opacity: 1; } 100% { opacity: 0; } }
  .flashing { animation: flashbg 1.7s ease-out 1; }
  @keyframes shakeit {
    10%,90% { transform: translateX(-2px); }
    20%,80% { transform: translateX(4px); }
    30%,50%,70% { transform: translateX(-6px); }
    40%,60% { transform: translateX(6px); }
  }
  .shake { animation: shakeit .7s cubic-bezier(.36,.07,.19,.97) both; }
  @keyframes blip { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
  .blip { animation: blip 1.4s ease-in-out infinite; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 9999px; }
  ::-webkit-scrollbar-track { background: transparent; }
  input[type=range] { accent-color: #22d3ee; }
  select option, select optgroup { background: #020617; color: #e2e8f0; }
  #nowMarker { transition: left .35s linear; }
</style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-cyan-400 selection:text-slate-950">

<!-- full screen state flash -->
<div id="flash" class="pointer-events-none fixed inset-0 z-40 opacity-0"></div>

<!-- alarm banner -->
<div id="alarmBar" class="fixed inset-x-0 top-0 z-50 hidden -translate-y-full items-center justify-center gap-3 bg-gradient-to-r from-rose-700 via-rose-600 to-rose-700 px-4 py-3 text-sm font-bold text-white shadow-2xl transition-transform duration-300">
  <i data-lucide="siren" class="h-5 w-5 blip"></i>
  <span class="truncate">PEAK WINDOW ACTIVE — surge pricing in effect</span>
  <button id="btnSilence" class="shrink-0 rounded-lg bg-black/30 px-3 py-1 text-[11px] font-black uppercase tracking-wider transition hover:bg-black/50">Silence</button>
</div>

<div class="mx-auto max-w-5xl px-4 py-6 sm:py-10">

  <!-- ================= HEADER ================= -->
  <header class="mb-6 flex flex-col gap-4 border-b border-white/10 pb-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <div class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-cyan-500/10 ring-1 ring-cyan-400/30">
        <i data-lucide="radar" class="h-6 w-6 text-cyan-400"></i>
      </div>
      <div>
        <h1 class="text-xl font-black tracking-tight sm:text-2xl">PEAK&nbsp;ALARM</h1>
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Off-peak surge tracker · every time zone</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button id="btnTest" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/10">
        <i data-lucide="play" class="h-4 w-4"></i> Test
      </button>
      <button id="btnSound" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/10">
        <i data-lucide="bell-off" class="h-4 w-4"></i><span>Alarm Off</span>
      </button>
      <button id="btnSettings" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/10">
        <i data-lucide="settings-2" class="h-4 w-4"></i> Setup
      </button>
    </div>
  </header>

  <!-- ================= ZONE PICKER ================= -->
  <section class="mb-5 grid gap-3 lg:grid-cols-[1fr_minmax(0,22rem)_auto]">
    <div class="relative">
      <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"></i>
      <input id="tzSearch" type="text" autocomplete="off" placeholder="Filter zones — try “Tokyo”, “Europe/”, “Edmonton”…"
        class="w-full rounded-xl border border-white/10 bg-slate-900/70 py-2.5 pl-10 pr-3 text-sm text-slate-200 placeholder:text-slate-500 focus:border-cyan-400/60 focus:outline-none" />
    </div>
    <div class="relative">
      <i data-lucide="globe-2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-cyan-400"></i>
      <select id="tzSelect" class="w-full appearance-none rounded-xl border border-white/10 bg-slate-900/70 py-2.5 pl-10 pr-9 text-sm font-medium text-slate-200 focus:border-cyan-400/60 focus:outline-none"></select>
      <i data-lucide="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"></i>
    </div>
    <button id="btnDetect" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs font-semibold text-slate-300 transition hover:bg-white/10">
      <i data-lucide="locate-fixed" class="h-4 w-4"></i> Auto-detect
    </button>
  </section>

  <!-- ================= STATUS CARD ================= -->
  <section id="card" class="relative mb-5 overflow-hidden rounded-3xl border border-white/10 bg-slate-900/40 p-6 text-center transition-all duration-500 sm:p-10">
    <div id="cardGlow" class="pointer-events-none absolute inset-0"></div>
    <div class="relative">
      <div id="badge" class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[10px] font-black uppercase tracking-[0.22em] text-slate-300">Initialising…</div>
      <div id="bigText" class="text-5xl font-black leading-none tracking-tighter sm:text-8xl">…</div>
      <p id="subText" class="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-slate-400">Calculating window state…</p>

      <div class="mx-auto mt-7 w-full max-w-md">
        <div class="mb-2 flex items-end justify-between gap-2 text-[11px] font-bold uppercase tracking-widest text-slate-400">
          <span id="cdLabel">Next change in</span>
          <span id="cdAt" class="font-mono text-[11px] normal-case tracking-normal text-slate-500">—</span>
        </div>
        <div id="cdTimer" class="font-mono text-4xl font-black tabular-nums tracking-tight sm:text-5xl">--:--:--</div>
        <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-white/5">
          <div id="progress" class="h-full w-0 rounded-full transition-[width] duration-500 ease-linear"></div>
        </div>
        <div class="mt-2 flex justify-between text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          <span id="progLeft">—</span><span id="progRight">—</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400"><i data-lucide="clock" class="h-3.5 w-3.5"></i> Local time</div>
      <div id="statLocal" class="font-mono text-2xl font-bold tabular-nums">--:--:--</div>
      <div id="statLocalDate" class="mt-0.5 truncate text-[11px] text-slate-500">—</div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400"><i data-lucide="globe" class="h-3.5 w-3.5"></i> UTC reference</div>
      <div id="statUTC" class="font-mono text-2xl font-bold tabular-nums">--:--:--</div>
      <div class="mt-0.5 text-[11px] text-slate-500">All windows defined in UTC</div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-rose-400"><i data-lucide="flame" class="h-3.5 w-3.5"></i> Next peak</div>
      <div id="statNextPeak" class="font-mono text-2xl font-bold tabular-nums text-rose-300">--</div>
      <div id="statNextPeakRel" class="mt-0.5 text-[11px] text-slate-500">—</div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-emerald-400"><i data-lucide="leaf" class="h-3.5 w-3.5"></i> Next off-peak</div>
      <div id="statNextOff" class="font-mono text-2xl font-bold tabular-nums text-emerald-300">--</div>
      <div id="statNextOffRel" class="mt-0.5 text-[11px] text-slate-500">—</div>
    </div>
  </section>

  <!-- ================= TIMELINE ================= -->
  <section class="mb-5 rounded-2xl border border-white/10 bg-slate-900/40 p-5">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">
        24-hour timeline · <span id="tlZone" class="text-cyan-300">—</span>
      </h2>
      <div class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-wider">
        <span class="inline-flex items-center gap-1.5 text-slate-300"><span class="h-2.5 w-2.5 rounded-sm bg-rose-500"></span>Peak</span>
        <span class="inline-flex items-center gap-1.5 text-slate-300"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-500"></span>Off-peak</span>
      </div>
    </div>
    <div class="relative">
      <div id="timeline" class="flex h-11 w-full gap-px overflow-hidden rounded-lg bg-slate-950/70 ring-1 ring-white/5"></div>
      <div id="nowMarker" class="pointer-events-none absolute -top-1.5 bottom-1.5 z-10 w-[2px] bg-white shadow-[0_0_12px_2px_rgba(255,255,255,.65)]" style="left:-10px">
        <div class="absolute -top-1 left-1/2 h-2.5 w-2.5 -translate-x-1/2 rotate-45 rounded-sm bg-white"></div>
      </div>
    </div>
    <div id="ticks" class="mt-1.5 flex justify-between font-mono text-[10px] text-slate-500"></div>
  </section>

  <!-- ================= WINDOW LISTS ================= -->
  <section class="mb-5 grid gap-3 md:grid-cols-2">
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-5">
      <h2 class="mb-3 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-rose-400">
        <i data-lucide="flame" class="h-4 w-4"></i> Peak windows · today in your zone
      </h2>
      <ul id="peakList" class="space-y-1.5 text-sm"></ul>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-5">
      <h2 class="mb-3 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-400">
        <i data-lucide="leaf" class="h-4 w-4"></i> Off-peak windows · today in your zone
      </h2>
      <ul id="offList" class="space-y-1.5 text-sm"></ul>
    </div>
  </section>

  <!-- ================= SETTINGS ================= -->
  <section id="settings" class="mb-5 hidden rounded-2xl border border-cyan-400/20 bg-cyan-500/[0.04] p-5">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-cyan-300">
        <i data-lucide="sliders-horizontal" class="h-4 w-4"></i> Configuration
      </h2>
      <button id="btnReset" class="text-[11px] font-bold uppercase tracking-wider text-slate-400 transition hover:text-rose-400">Reset all</button>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Schedule preset</span>
        <select id="preset" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2.5 text-sm focus:border-cyan-400/60 focus:outline-none"></select>
      </label>

      <label class="block">
        <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Alarm lead time</span>
        <select id="lead" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2.5 text-sm focus:border-cyan-400/60 focus:outline-none">
          <option value="0">Exactly at the change</option>
          <option value="1">1 minute before</option>
          <option value="5">5 minutes before</option>
          <option value="10">10 minutes before</option>
          <option value="30">30 minutes before</option>
        </select>
      </label>

      <label id="customWrap" class="hidden sm:col-span-2">
        <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Custom PEAK windows (UTC, 24-hour)</span>
        <input id="customWindows" type="text" spellcheck="false" placeholder="01:00-04:00, 06:00-10:00"
          class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2.5 font-mono text-sm focus:border-cyan-400/60 focus:outline-none" />
        <span id="customMsg" class="mt-1 block text-[11px] text-slate-500">Comma-separated HH:MM-HH:MM ranges. Overnight ranges like 23:00-02:00 work too.</span>
      </label>

      <div class="flex items-center justify-between rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3">
        <span class="text-sm font-medium">Weekends always off-peak</span>
        <input id="weekend" type="checkbox" class="h-5 w-5 accent-cyan-400" />
      </div>

      <div class="flex items-center justify-between rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3">
        <span class="text-sm font-medium">Persistent alarm (repeats)</span>
        <input id="persistent" type="checkbox" class="h-5 w-5 accent-cyan-400" />
      </div>

      <div class="flex items-center justify-between rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3">
        <span class="text-sm font-medium">Use 12-hour clock</span>
        <input id="hour12" type="checkbox" class="h-5 w-5 accent-cyan-400" />
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3">
        <div class="mb-2 flex items-center justify-between text-sm font-medium">
          <span>Alarm volume</span><span id="volLabel" class="font-mono text-xs text-slate-400">35%</span>
        </div>
        <input id="volume" type="range" min="0" max="100" step="1" class="w-full" />
      </div>

      <button id="btnNotify" class="flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3 text-sm font-medium transition hover:bg-white/5 sm:col-span-2">
        <i data-lucide="bell-ring" class="h-4 w-4"></i> Enable desktop notifications
      </button>
    </div>
  </section>

  <footer class="border-t border-white/10 pt-5 text-center text-[11px] leading-relaxed text-slate-500">
    <p>Alarms use the browser <span class="text-slate-400">Web Audio API</span> — no external sound files. Your zone and settings are saved locally in your browser.</p>
    <p class="mt-1">Default preset: <span class="text-slate-400">Weekday split</span>. Switch to <span class="text-slate-400">DeepSeek official</span> in Setup for the real 16:30–00:30 UTC discount window.</p>
  </footer>
</div>

<noscript>
  <div class="mx-auto max-w-lg p-6 text-center text-rose-400">This dashboard needs JavaScript enabled.</div>
</noscript>

<script>
(function () {
  "use strict";

  /* ============================================================
     CONSTANTS
     ============================================================ */
  var DAY = 86400000, MIN = 60000, HALF = 1800000;

  var PRESETS = {
