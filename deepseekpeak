    bannerShown: false,
    repeatTimer: null,
    repeatCount: 0,
    leadKey: null
  };

  var AC = null;

  /* ============================================================
     ELEMENT REFS
     ============================================================ */
  var $ = function (id) { return document.getElementById(id); };

  var el = {
    flash: $("flash"),
    alarmBar: $("alarmBar"),
    btnSilence: $("btnSilence"),
    btnTest: $("btnTest"),
    btnSound: $("btnSound"),
    btnSettings: $("btnSettings"),
    tzSearch: $("tzSearch"),
    tzSelect: $("tzSelect"),
    btnDetect: $("btnDetect"),
    card: $("card"),
    cardGlow: $("cardGlow"),
    badge: $("badge"),
    bigText: $("bigText"),
