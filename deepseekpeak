  /* ============================================================
     STATE
     ============================================================ */
  var LS_KEY = "peakAlarm.v1";

  var state = {
    tz: "",
    preset: "split",
    customWindows: [[60, 240], [360, 600]],
    weekendsOffPeak: true,
    sound: false,
    persistent: true,
    lead: 0,
    hour12: false,
